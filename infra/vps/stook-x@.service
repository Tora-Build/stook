[Unit]
Description=Stook poster: render today's %i video and post it to Telegram
After=network-online.target
Wants=network-online.target
OnFailure=stook-x-alert@%i.service

[Service]
Type=oneshot
User=zak
WorkingDirectory=/home/zak/stook/infra/x-poster
EnvironmentFile=/home/zak/stook.env
EnvironmentFile=-/home/zak/stook-alerts.env
Environment=DAILY_CHROME=/home/zak/.cache/ms-playwright/chromium_headless_shell-1243/chrome-headless-shell-linux-arm64/chrome-headless-shell
ExecStart=/usr/bin/node /home/zak/stook/infra/x-poster/src/render.mjs %i
# A guest on a shared box: low priority, one core, bounded memory.
Nice=10
CPUQuota=100%
MemoryMax=3G
TimeoutStartSec=30min
StandardOutput=append:/home/zak/stook-x.log
StandardError=append:/home/zak/stook-x.log
