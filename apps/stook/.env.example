# Solana RPC. Devnet's public endpoint works for a demo; a proxy that keeps a
# provider key server-side is in infra/rpc-proxy.
VITE_RPC_URL=https://api.devnet.solana.com

# The quote token markets are created in by default: the devnet mock USDC that
# scripts/devnet/setup.mjs creates. 6 decimals.
VITE_QUOTE_MINT=

# Devnet faucet for that mock token: the mint authority's secret key as a JSON
# byte array. Deliberately public — the token is valueless and minting it
# freely is the faucet's purpose. Leave empty to hide the faucet.
VITE_FAUCET_AUTHORITY_BYTES=

# Pyth prices for the live line on the chart. Hermes needs an API key, which
# must not ship in a browser bundle, so point this at a proxy that adds it
# (infra/rpc-proxy serves /hermes/*). Leave empty to hide the live price.
VITE_HERMES_URL=
