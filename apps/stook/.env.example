# Solana RPC. Empty uses the devnet proxy in infra/rpc-proxy, which keeps a
# provider key server-side; devnet's public endpoint also works for a demo.
VITE_RPC_URL=https://api.devnet.solana.com
# Confirmations subscribe over a websocket, which the HTTP proxy cannot carry.
# Empty uses wss://api.devnet.solana.com/.
VITE_WS_URL=
# For getProgramAccounts only, which keyed free tiers refuse. Empty uses
# https://api.devnet.solana.com.
VITE_SCAN_RPC_URL=

# The devnet mock USDC that scripts/devnet/setup.mjs creates (6 decimals).
# The faucet hands it out.
VITE_QUOTE_MINT=

# Devnet faucet: the mint authority's secret key as a JSON byte array.
# Deliberately public: the tokens are valueless and minting them freely is
# the faucet's purpose. Leave empty to hide the faucet.
VITE_FAUCET_AUTHORITY_BYTES=

# Devnet twins of the street coins, {"STOOK": "<mint>", ...}, written by
# scripts/devnet/coins.mjs. Set, it also marks the app as devnet: rounds run on
# the crypto stand-in feeds. Empty uses the mainnet mints and anchor feeds.
VITE_DEVNET_MINTS=

# $STOOK's mainnet mint (kept out of the repo). The Worker reads the same from its STOOK_MINT secret.
VITE_STOOK_MINT=
